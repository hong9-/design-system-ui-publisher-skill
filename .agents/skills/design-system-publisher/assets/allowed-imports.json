{
  "productScreens": {
    "allowed": [
      "@my/ui",
      "@my/design-tokens",
      "@my/design-contract",
      "react",
      "react-router",
      "next",
      "expo-router"
    ],
    "discouraged": [
      "react-native",
      "react-native-web"
    ],
    "forbiddenUnlessInUiPackage": [
      "View",
      "Text",
      "Pressable",
      "TouchableOpacity",
      "div",
      "span",
      "button"
    ]
  },
  "uiPackage": {
    "allowedLowLevelPrimitives": [
      "View",
      "Text",
      "Pressable",
      "TouchableOpacity",
      "div",
      "span",
      "button",
      "input"
    ]
  }
}
