{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design System Manifest",
  "type": "object",
  "required": [
    "version",
    "sources",
    "packages",
    "platforms",
    "requiredChecks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "type": "object",
          "required": [
            "mode",
            "source",
            "config",
            "outputs"
          ],
          "properties": {
            "mode": {
              "enum": [
                "style-dictionary",
                "custom"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "config": {
              "type": "string",
              "minLength": 1
            },
            "outputs": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "web": {
                  "type": "string",
                  "minLength": 1
                },
                "native": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "figma": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "packages": {
      "type": "object",
      "required": [
        "tokens",
        "ui"
      ],
      "properties": {
        "tokens": {
          "type": "string",
          "minLength": 1
        },
        "ui": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tokenLayers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "web",
          "native"
        ]
      },
      "uniqueItems": true
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
