{
  "ignoredDirs": [
    ".git",
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".next",
    ".expo",
    "ios",
    "android"
  ],
  "ignoredPathIncludes": [
    "/packages/ui/",
    "/design-tokens/",
    "/.agents/skills/",
    "/.design-system/"
  ],
  "extensions": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".css",
    ".scss"
  ],
  "patterns": [
    {
      "type": "raw-color",
      "regex": "#[0-9a-fA-F]{3,8}\\b|\\brgba?\\(|\\bhsla?\\("
    },
    {
      "type": "raw-style-number",
      "regex": "\\b(?:padding(?:Top|Right|Bottom|Left|Horizontal|Vertical|Block|Inline)?|margin(?:Top|Right|Bottom|Left|Horizontal|Vertical|Block|Inline)?|gap|rowGap|columnGap|borderRadius|border(?:TopLeft|TopRight|BottomLeft|BottomRight)?Radius|fontSize|lineHeight|letterSpacing|fontWeight|width|height|minWidth|minHeight|maxWidth|maxHeight|top|right|bottom|left|inset|zIndex|padding(?:-(?:top|right|bottom|left|block|inline))?|margin(?:-(?:top|right|bottom|left|block|inline))?|row-gap|column-gap|border-radius|border-(?:top-left|top-right|bottom-left|bottom-right)-radius|font-size|line-height|letter-spacing|font-weight|min-width|min-height|max-width|max-height|z-index)\\s*:\\s*(?:['\"])?-?\\d+(?:\\.\\d+)?(?:px|rem|em|%)?(?:['\"])?"
    },
    {
      "type": "inline-style-object",
      "regex": "\\bstyle\\s*=\\s*\\{\\s*\\{"
    },
    {
      "type": "design-lint-suppression",
      "regex": "eslint-disable[^\\n]*design|@ts-ignore[^\\n]*design"
    }
  ]
}
